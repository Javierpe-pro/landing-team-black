# =====================================================================
# Variables de entorno · Landing Team Black by Amaya
# Copiá este archivo a .env.local (local) o cargalas en Vercel → Settings → Environment Variables.
# NUNCA commitees claves reales. NUNCA pongas la service role key en una variable NEXT_PUBLIC_.
# =====================================================================

# --- Almacenamiento de leads ---
# "file"     → guarda en ./.data/leads.jsonl (solo para desarrollo local)
# "supabase" → guarda en la tabla public.leads (Vercel / producción)
# "log"      → no guarda nada, solo lo escribe en los logs (previews visuales sin base)
LEADS_STORAGE=file

# --- Supabase (solo servidor) ---
# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API → service_role (secreta: solo servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Sal para hashear la IP (cualquier texto largo y aleatorio)
IP_HASH_SALT=

# --- Sitio ---
# URL pública final, sin barra al final (para Open Graph). Ej: https://alquileres.amaya.realestate
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp de Javier, formato wa.me (549 + código de área + número)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491126509698
# "true" solo en producción final. Mientras sea false: noindex + robots.txt bloqueado
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Meta Pixel de Javier ---
# ID del Pixel (Administrador de eventos → Orígenes de datos)
NEXT_PUBLIC_META_PIXEL_ID=
# "true" SOLO en el despliegue productivo de Javier. En local y en Vercel de prueba: false
NEXT_PUBLIC_PIXEL_ENABLED=false
# "true" imprime cada evento en la consola del navegador (para verificar)
NEXT_PUBLIC_PIXEL_DEBUG=false
